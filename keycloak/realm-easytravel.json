{
  "realm": "easytravel",
  "displayName": "EasyTravel",
  "displayNameHtml": "easy<span class=\"et-accent\">travel</span>",
  "loginTheme": "easytravel",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      { "name": "customer", "description": "Books, views and cancels their own trips" },
      { "name": "ops", "description": "Opens the Ops room and uses its controls" }
    ]
  },
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@easytravel.test",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Demo",
      "credentials": [ { "type": "password", "value": "alice-demo", "temporary": false } ],
      "realmRoles": [ "customer" ]
    },
    {
      "username": "ops-admin",
      "enabled": true,
      "email": "ops@easytravel.test",
      "emailVerified": true,
      "firstName": "Ops",
      "lastName": "Admin",
      "credentials": [ { "type": "password", "value": "ops-demo", "temporary": false } ],
      "realmRoles": [ "customer", "ops" ]
    }
  ],
  "clients": [
    {
      "clientId": "web-ui",
      "name": "EasyTravel website",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${EASYTRAVEL_OIDC_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [ "http://localhost:9080/*" ],
      "webOrigins": [ "http://localhost:9080" ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:9080/*"
      },
      "protocolMappers": [
        {
          "name": "realm roles as groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}
