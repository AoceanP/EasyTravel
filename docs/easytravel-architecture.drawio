<mxfile host="app.diagrams.net"><diagram id="architecture" name="architecture"><mxGraphModel dx="1240" dy="880" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="880" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;EasyTravel&lt;/b&gt;: five Spring Boot services, one message broker (all demo data is fake)" style="whiteSpace=wrap;html=1;text;align=left;fontSize=15;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1200" height="30" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Client&lt;/b&gt;&lt;br&gt;curl / browser" style="whiteSpace=wrap;html=1;ellipse;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="560" y="70" width="200" height="60" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;API Gateway&lt;/b&gt; :8080&lt;br&gt;&lt;i&gt;one front door, routes /api/**&lt;/i&gt;" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="530" y="170" width="260" height="70" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Discovery Server&lt;/b&gt; :8761&lt;br&gt;Eureka&lt;br&gt;&lt;i&gt;who is running where&lt;/i&gt;" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="200" height="100" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Inventory Service&lt;/b&gt; :8081&lt;br&gt;search, rank, quote&lt;br&gt;&lt;i&gt;5 mock flights&lt;/i&gt;" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="290" y="310" width="220" height="100" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Booking Service&lt;/b&gt; :8082&lt;br&gt;prices bookings server-side&lt;br&gt;&lt;i&gt;own H2 database&lt;/i&gt;" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="640" y="310" width="240" height="100" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Payment Service&lt;/b&gt; :8083&lt;br&gt;mock card, declines over 2000.00&lt;br&gt;&lt;i&gt;own H2 database&lt;/i&gt;" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="940" y="310" width="240" height="100" as="geometry"/></mxCell><mxCell id="c8" value="HTTP JSON" style="endArrow=block;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" value="/api/flights/**" style="endArrow=block;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="/api/bookings/**" style="endArrow=block;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.6;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="/api/payments/**" style="endArrow=block;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c3" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="price quote,&lt;br&gt;by service name" style="endArrow=block;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="every service registers here,&lt;br&gt;callers look names up" style="endArrow=block;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#666666;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;RabbitMQ&lt;/b&gt; :5672 (UI :15672)" style="whiteSpace=wrap;html=1;rounded=1;dashed=1;fillColor=none;strokeColor=#d79b00;verticalAlign=top;align=right;spacingRight=14;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="620" y="470" width="580" height="390" as="geometry"/></mxCell><mxCell id="c15" value="booking.exchange&lt;br&gt;&lt;i&gt;booking.created&lt;/i&gt;" style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="700" y="560" width="160" height="56" as="geometry"/></mxCell><mxCell id="c16" value="payment.booking-&lt;br&gt;created.queue" style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="940" y="560" width="140" height="56" as="geometry"/></mxCell><mxCell id="c17" value="booking.payment-&lt;br&gt;completed.queue" style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="640" y="680" width="220" height="56" as="geometry"/></mxCell><mxCell id="c18" value="payment.exchange&lt;br&gt;&lt;i&gt;payment.completed&lt;/i&gt;" style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="940" y="680" width="240" height="56" as="geometry"/></mxCell><mxCell id="c19" value="easytravel.dlx → *.dlq&lt;br&gt;&lt;i&gt;a message that still fails after 3 tries is parked here, not retried forever&lt;/i&gt;" style="whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="640" y="780" width="540" height="56" as="geometry"/></mxCell><mxCell id="c20" value="1" style="endArrow=block;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.6;exitY=1;exitDx=0;exitDy=0;entryX=0.525;entryY=0;entryDx=0;entryDy=0;strokeColor=#d79b00;" edge="1" parent="1" source="c6" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="" style="endArrow=block;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#d79b00;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="2" style="endArrow=block;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.2917;entryY=1;entryDx=0;entryDy=0;strokeColor=#d79b00;" edge="1" parent="1" source="c16" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="3" style="endArrow=block;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;strokeColor=#d79b00;" edge="1" parent="1" source="c7" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="" style="endArrow=block;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#d79b00;" edge="1" parent="1" source="c18" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="4" style="endArrow=block;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.0909;exitY=0;exitDx=0;exitDy=0;entryX=0.0833;entryY=1;entryDx=0;entryDy=0;strokeColor=#d79b00;" edge="1" parent="1" source="c17" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;The booking saga&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1.&lt;/b&gt; Booking saves the booking as PENDING, answers the client 201 at once, then publishes &lt;i&gt;BookingCreatedEvent&lt;/i&gt; (only after the database commit).&lt;br&gt;&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; Payment consumes it, skips it if this booking was already charged, otherwise charges the mock card.&lt;br&gt;&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; Payment publishes &lt;i&gt;PaymentEvent&lt;/i&gt;: success, or failure with a reason.&lt;br&gt;&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; Booking consumes it: PENDING becomes CONFIRMED or PAYMENT_FAILED. A duplicate or late event never changes a decided booking.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why a broker?&lt;/b&gt; If payment-service is down, events wait in the durable queue and are processed when it comes back." style="whiteSpace=wrap;html=1;text;align=left;verticalAlign=top;fontSize=12;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="540" height="390" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>